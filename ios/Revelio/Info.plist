<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Revelio</string>
    <key>CFBundleName</key>
    <string>Revelio</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchScreenBackground</string>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Revelio uses your camera to scan product barcodes for ingredient analysis.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Revelio saves your scan scorecards to your Camera Roll so you can share them.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Revelio reads receipt photos from your library to score every item in one trip.</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>revelio</string>
            </array>
        </dict>
    </array>
    <!--
      Universal Links. The canonical home for `applinks:` is the target's
      entitlements file (see Revelio.entitlements) — duplicating the hint
      here as a discoverability anchor so anyone auditing the plist can see
      that revelio.app is bound to the app. Xcode's "Associated Domains"
      capability must still be enabled in Signing & Capabilities for the
      provisioning profile to carry the entitlement.
    -->
    <key>RevelioAssociatedDomains</key>
    <array>
        <string>applinks:revelio.app</string>
        <string>applinks:www.revelio.app</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>17.0</string>
    <!--
      App Transport Security.
      Arbitrary loads are forbidden app-wide. DEBUG builds are allowed to talk
      to localhost (and 127.0.0.1 / ::1) over plain HTTP so the simulator can
      hit a dev server; release builds must use HTTPS for every destination.
      The NetworkClient additionally enforces this in code via scheme checks
      and SPKI pinning against the production leaf certificate.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <!-- DEBUG-only: NetworkClient refuses http:// in release anyway. -->
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <false/>
            </dict>
            <key>127.0.0.1</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSExceptionRequiresForwardSecrecy</key>
                <false/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
