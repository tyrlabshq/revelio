<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <!--
      Universal Links. `applinks:revelio.app` tells iOS to fetch
      https://revelio.app/.well-known/apple-app-site-association at install
      time and, on match, hand tapped https://revelio.app/p/<barcode> URLs
      to this app via NSUserActivityTypeBrowsingWeb (see
      Services/UniversalLinkHandler.swift). The main session must also
      enable "Associated Domains" in the Xcode target's Signing &
      Capabilities pane so the provisioning profile carries the entitlement.
    -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:revelio.app</string>
        <string>applinks:www.revelio.app</string>
    </array>
</dict>
</plist>
