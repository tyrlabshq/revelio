PORT=8430                                              # Express listen port (must match fly.toml internal_port)
DATABASE_URL=postgresql://revelio:devpassword@localhost:5432/revelio  # Postgres connection string (fly postgres attach output)
REDIS_URL=redis://localhost:6379                        # Redis for caching/sessions
JWT_SECRET=change_me_in_production                     # Auth signing secret — generate with: openssl rand -hex 32 (REQUIRED in prod)
AMAZON_AFFILIATE_TAG=revelio-20                        # Amazon affiliate tag for product links
